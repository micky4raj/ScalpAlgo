# Safe default. Change only after validating paper performance.
EXECUTION_MODE=PAPER
INSTRUMENT_TYPE=OPTION

# Live mode only. Save these in Replit Secrets, never in this file or chat.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
DHAN_SUBSCRIPTIONS=NSE_FNO:12345
LIVE_TRADING_CONFIRMATION=

# Strategy and risk
ORDER_QUANTITY=50
MAX_DAILY_LOSS=5000
MAX_DRAWDOWN=7500
STOP_LOSS_POINTS=8
OPTION_TARGET_POINTS=12
INDEX_TARGET_POINTS=25

# Journal
JOURNAL_DATABASE_PATH=data/trading_journal.sqlite3
LOG_EVERY_TICK=false

# Cost overrides; verify the current rate card before LIVE mode.
BROKERAGE_FLAT=20
BROKERAGE_RATE=0.0003
OPTION_STT_SELL_RATE=0.000625
FUTURES_STT_SELL_RATE=0.000125
EXCHANGE_TURNOVER_RATE=0.0000297
SEBI_TURNOVER_RATE=0.000001
STAMP_DUTY_BUY_RATE=0.00003
GST_RATE=0.18